# INVESTCOPS AI - Backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env.

# Application
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database (PostgreSQL in production; SQLite fallback for local dev)
# DATABASE_URL=postgresql://investcops:investcops@localhost:5432/investcops
DATABASE_URL=sqlite:///./investcops.db

# Graph Database (Neo4j) - optional; graph features degrade gracefully when disabled
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me

# Authentication (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Evidence file storage (development: local directory)
LOCAL_STORAGE_DIR=data/evidence
MAX_UPLOAD_MB=200
# ALLOWED_EXTENSIONS=txt,json,pdf,jpg,jpeg,png,mp4,webm,mp3,wav,m4a,apk,html,csv,zip,eml,msg

# Object storage (production; S3-compatible)
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# Processing integrations (optional; disable features when unset)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   (OCR)
# WHISPER_API_KEY=                                                (audio transcription)
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# AI Agents service URL (reserved for distributed deployment; in-process execution used by default)
AGENTS_SERVICE_URL=http://localhost:8001

# LLM provider used by the agents (none | gemini | openai | local)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_MAX_CONTEXT_CHARS=40000

# Ollama - FIR conversion (falls back to deterministic mock when offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
MAX_FIR_CHARS=20000
MAX_SYSTEM_CHARS=4000

# CORS (the frontend dev server proxies /api; wildcard works for direct browser calls)
CORS_ORIGINS=*